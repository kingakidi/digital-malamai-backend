# Server
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
SWAGGER_PATH=api-docs

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=digital_malamai

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# SMTP (leave host/user/pass empty locally to skip sending; keys must still be set)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Digital Malamai <no-reply@digitalmalamai.com>

# OTP
OTP_TTL_MINUTES=10
OTP_HASH_SECRET=change-me-in-production

# WhatsApp (twilio | meta) — Twilio is default
WHATSAPP_DEFAULT_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Meta WhatsApp Cloud API (used when WHATSAPP_DEFAULT_PROVIDER=meta)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v21.0

# SMS via Termii (disabled by default; set SMS_ENABLED=true to send)
SMS_ENABLED=false
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com/api

# Flutterwave
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_SECRET_HASH=your-flutterwave-webhook-hash
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_DEFAULT_CURRENCY=NGN

# Onboarding fee (seeded on first startup if not in database)
DEFAULT_ONBOARDING_FEE=10000

# Initial superadmin (seeded on first startup)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin
