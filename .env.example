# Server
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
SWAGGER_PATH=api-docs
DEBUG_REQUEST_LOGS=true
PAYMENT_DEBUG_LOGS=false
PARTNER_PORTAL_LOGIN_URL=http://localhost:5173/partner/login
STAFF_PORTAL_LOGIN_URL=http://localhost:5173/staff/login
# Comma-separated browser origins allowed to call the API (Live Server, frontends, etc.)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=digital_malamai

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# SMTP — Resend example (same shape as GLD Python EMAIL_* vars)
# Port 465: SMTP_USE_SSL=true, SMTP_USE_TLS=false
# Port 587: SMTP_USE_SSL=false, SMTP_USE_TLS=true
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
SMTP_FROM=Digital Malamai <noreply@yourdomain.com>
# Optional alias (same as Python DEFAULT_FROM_EMAIL)
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# OTP
OTP_TTL_MINUTES=10
OTP_HASH_SECRET=change-me-in-production

# WhatsApp (twilio | meta) — Twilio is default
WHATSAPP_DEFAULT_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Meta WhatsApp Cloud API (used when WHATSAPP_DEFAULT_PROVIDER=meta)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v21.0

# SMS via Termii (disabled by default; set SMS_ENABLED=true to send)
SMS_ENABLED=false
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com/api

# Flutterwave
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_SECRET_HASH=your-flutterwave-webhook-hash
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_DEFAULT_CURRENCY=NGN

# Onboarding fee (seeded on first startup if not in database)
DEFAULT_ONBOARDING_FEE=10000

# Initial superadmin (seeded on startup and via npm run seed:superadmin)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# S3-compatible object storage (optional — required for media uploads)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET_NAME=
# Optional custom endpoint (MinIO, DigitalOcean Spaces, etc.)
S3_ENDPOINT=
# Optional public CDN/base URL; when set, media URLs use this instead of presigned links
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
