# Server
PORT=3001

# CORS — comma-separated full origins (frontend on port 3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database schema management
# Local development (auto-sync schema from entities — convenient but not for production):
DB_SYNCHRONIZE=true
# Production (apply pending migrations on startup):
# DB_SYNCHRONIZE=false
# DB_MIGRATIONS_RUN=true
