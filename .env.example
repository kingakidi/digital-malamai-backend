# Server
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1
SWAGGER_PATH=api-docs
DEBUG_REQUEST_LOGS=true
PAYMENT_DEBUG_LOGS=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=digital_malamai
# Development: synchronize=true is OK for local iteration.
# Production: set synchronize=false and run migrations instead:
#   npm run migration:run        (dev / ts-node)
#   npm run build && npm run migration:run:prod
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Digital Malamai <noreply@example.com>

# OTP
OTP_TTL_MINUTES=10
OTP_HASH_SECRET=change-me-in-production

# WhatsApp (twilio | meta)
WHATSAPP_DEFAULT_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Meta WhatsApp
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v21.0

# SMS (Termii)
SMS_ENABLED=false
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com/api

# Flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_DEFAULT_CURRENCY=NGN
FLUTTERWAVE_REQUEST_TIMEOUT_MS=20000

# Onboarding
DEFAULT_ONBOARDING_FEE=2000

# Superadmin seed
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
STAFF_PORTAL_LOGIN_URL=http://localhost:3000/login
PARTNER_PORTAL_LOGIN_URL=http://localhost:3000/login

# S3 / Contabo / MinIO (optional). Same keys as Fileam.
# Use 127.0.0.1 instead of localhost to avoid IPv6 (::1) issues on Windows.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET_NAME=
S3_BUCKET_URL=
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true

# Throttle (optional)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=20
