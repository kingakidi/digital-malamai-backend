              }
            },
            {
              "name": "List own students",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/partners/students?page=1&limit=20"
              }
            },
            {
              "name": "Revenue summary",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/partners/revenue"
              }
            },
            {
              "name": "Get course by slug",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/partners/courses/slug/{{courseSlug}}"
              }
            },
            {
              "name": "List enrollments",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/partners/enrollments?page=1&limit=20"
              }
            },
            {
              "name": "Onboarding payments",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/partners/payments/onboarding?page=1&limit=20"
              }
            },
            {
              "name": "Course payments",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/partners/payments/courses?page=1&limit=20"
              }
            },
            {
              "name": "List team users",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/partners/team-users"
              }
            },
            {
              "name": "Create team user",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstName\": \"Team\",\n  \"lastName\": \"Member\",\n  \"email\": \"team@partner.com\"\n}"
                },
                "url": "{{baseUrl}}/partners/team-users",
                "description": "Max 5 team login users per partner."
              }
            },
            {
              "name": "Update team user",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstName\": \"Updated\"\n}"
                },
                "url": "{{baseUrl}}/partners/team-users/{{userId}}"
              }
            },
            {
              "name": "Delete team user",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": "{{baseUrl}}/partners/team-users/{{userId}}"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin Partners",
      "item": [
        {
          "name": "Create partner + login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
