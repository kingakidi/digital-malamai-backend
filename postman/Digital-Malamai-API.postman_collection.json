{
  "info": {
    "_postman_id": "digital-malamai-api-v1",
    "name": "Digital Malamai API",
    "description": "NestJS backend for Digital Malamai.\n\n**Base URL:** `{{baseUrl}}`\n\n**Auth:** Bearer `{{accessToken}}` (set automatically after Staff Login or Student Login).\n\n**Response envelope:**\n```json\n{ \"status\": true, \"message\": \"...\", \"data\": {} }\n```\n\n**Errors:** `message` is human-readable; `error` is the status category or validation array.\n```json\n{ \"status\": false, \"message\": \"Access code has already been used\", \"error\": \"Conflict\" }\n```",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1" },
    { "key": "rootUrl", "value": "http://localhost:3001" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "roleId", "value": "" },
    { "key": "partnerId", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "videoId", "value": "" },
    { "key": "courseSlug", "value": "" },
    { "key": "flutterwaveSecretHash", "value": "your-flutterwave-webhook-hash" }
  ],
  "item": [
    {
      "name": "Welcome",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Root welcome",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rootUrl}}/"
          }
        },
        {
          "name": "API welcome",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Staff login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data?.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/staff/login"
          }
        },
        {
          "name": "Login (alias)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Student check payment eligibility",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.student@example.com\",\n  \"paidFor\": \"onboarding\",\n  \"partnerId\": \"{{partnerId}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/student/check-payment-eligibility",
            "description": "Public. Checks local database and Flutterwave (last 30 days, proxied via backend) for an existing successful onboarding payment for this email + partner. Use `paidFor: course` with `courseId` for course purchases."
          }
        },
        {
          "name": "Student register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partnerId\": \"{{partnerId}}\",\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane.student@example.com\",\n  \"phone\": \"08012345678\",\n  \"accessCode\": \"ABC123\"\n}"
            },
            "url": "{{baseUrl}}/auth/student/register",
            "description": "Validates partner, email, phone, and access code only. Does **not** create a student account or mark the access code used. Returns `onboardingFee` and `currency` for Flutterwave checkout. Include the same fields in payment metadata: `paidFor: onboarding`, `email`, `partnerId`, `accessCode`, `fullName`, `phone`."
          }
        },
        {
          "name": "Student verify onboarding payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"txRef\": \"dm-onboard-1234567890-abc123\",\n  \"transactionId\": \"1234567\",\n  \"email\": \"jane.student@example.com\",\n  \"partnerId\": \"{{partnerId}}\",\n  \"accessCode\": \"ABC123\",\n  \"fullName\": \"Jane Doe\",\n  \"phone\": \"08012345678\"\n}"
            },
            "url": "{{baseUrl}}/auth/student/verify-onboarding-payment",
            "description": "Public endpoint (no auth). Idempotent: safe to call multiple times. Prefer `txRef` when available. Include registration fallback fields when Flutterwave metadata is empty. Creates student if missing; skips if already registered."
          }
        },
        {
          "name": "Student requery onboarding payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"txRef\": \"dm-onboard-1234567890-abc123\",\n  \"email\": \"jane.student@example.com\",\n  \"partnerId\": \"{{partnerId}}\",\n  \"accessCode\": \"ABC123\",\n  \"fullName\": \"Jane Doe\",\n  \"phone\": \"08012345678\"\n}"
            },
            "url": "{{baseUrl}}/auth/student/requery-onboarding-payment",
            "description": "Same as verify onboarding payment. Use to manually requery Flutterwave and complete registration if webhook/redirect failed."
          }
        },
        {
          "name": "Student login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data?.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"jane.student@example.com\",\n  \"credential\": \"ABC123\"\n}"
            },
            "url": "{{baseUrl}}/auth/student/login",
            "description": "Works only after onboarding payment creates the student account. Use email or phone as `identifier` and the access code as `credential`."
          }
        },
        {
          "name": "Forgot password — send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"jane.student@example.com\",\n  \"type\": \"email\"\n}"
            },
            "url": "{{baseUrl}}/auth/forgot-password/send"
          }
        },
        {
          "name": "Forgot password — reset",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"jane.student@example.com\",\n  \"type\": \"email\",\n  \"code\": \"123456\",\n  \"newPassword\": \"NewSecurePass1\"\n}"
            },
            "url": "{{baseUrl}}/auth/forgot-password/reset"
          }
        },
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\"\n}"
            },
            "url": "{{baseUrl}}/auth/profile",
            "description": "Authenticated user updates own firstName / lastName (all roles)."
          }
        },
        {
          "name": "OTP — send",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"email\"\n}"
            },
            "url": "{{baseUrl}}/auth/otp/send",
            "description": "Student auth required. type: email | phone"
          }
        },
        {
          "name": "OTP — verify",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"email\",\n  \"code\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/otp/verify"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=20&sortBy=createdAt&sortOrder=DESC",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "DESC" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Manager\",\n  \"email\": \"manager@example.com\",\n  \"password\": \"SecurePass123\",\n  \"roleId\": \"{{roleId}}\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get user by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Manager Updated\"\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Admin Users",
      "description": "Superadmin only — staff accounts (excludes students)",
      "item": [
        {
          "name": "List staff accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=1&limit=20&role=",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "role", "value": "", "description": "superadmin | admin | manager | partner" }
              ]
            },
            "description": "Paginated staff accounts. Optional: `search`, `role`, `sortBy`, `sortOrder`."
          }
        },
        {
          "name": "Create staff account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Admin\",\n  \"email\": \"alice@example.com\",\n  \"roleId\": \"{{roleId}}\"\n}"
            },
            "url": "{{baseUrl}}/admin/users",
            "description": "Superadmin only. Password is optional — a temporary password is emailed if omitted. Admin/manager roles only (not partner or superadmin)."
          }
        },
        {
          "name": "Resend staff welcome email",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/admin/users/{{userId}}/resend-welcome-email",
            "description": "Superadmin only. Generates a new temporary password and emails it asynchronously."
          }
        },
        {
          "name": "Change password (staff)",
          "auth": {
            "type": "bearer",
            "bearer": [
              { "key": "token", "value": "{{accessToken}}", "type": "string" }
            ]
          },
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"TEMP_PASSWORD_FROM_EMAIL\",\n  \"newPassword\": \"NewSecurePass123\"\n}"
            },
            "url": "{{baseUrl}}/auth/change-password",
            "description": "Required on first login for staff/partner accounts. Clears `mustChangePassword`."
          }
        },
        {
          "name": "Patch staff account",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Permission groups",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/roles/permissions/groups"
          }
        },
        {
          "name": "List roles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/roles?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["roles"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Create role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"support_lead\",\n  \"title\": \"Support Lead\",\n  \"permissionKeys\": [\"users:read:all\", \"roles:read:all\"]\n}"
            },
            "url": "{{baseUrl}}/roles"
          }
        },
        {
          "name": "Get role by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/roles/{{roleId}}"
          }
        },
        {
          "name": "Update role",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Support Lead Updated\",\n  \"permissionKeys\": [\"users:read:all\"]\n}"
            },
            "url": "{{baseUrl}}/roles/{{roleId}}"
          }
        },
        {
          "name": "Delete role",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/roles/{{roleId}}"
          }
        }
      ]
    },
    {
      "name": "Partners",
      "item": [
        {
          "name": "Public",
          "auth": { "type": "noauth" },
          "item": [
            {
              "name": "List active partners",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const res = pm.response.json();",
                      "pm.test('Status 200', () => pm.response.to.have.status(200));",
                      "if (res.data?.data?.length) {",
                      "  const partner = res.data.data[0];",
                      "  pm.collectionVariables.set('partnerId', partner.id);",
                      "  pm.test('Public shape: includes onboardingFee key', () => {",
                      "    pm.expect(partner).to.have.property('onboardingFee');",
                      "  });",
                      "  pm.test('Public shape: no commission fields', () => {",
                      "    pm.expect(partner).to.not.have.property('commissionType');",
                      "    pm.expect(partner).to.not.have.property('commissionValue');",
                      "    pm.expect(partner).to.not.have.property('onboardPercentage');",
                      "  });",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/partners?page=1&limit=20",
                  "host": ["{{baseUrl}}"],
                  "path": ["partners"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "20" }
                  ]
                },
                "description": "Public endpoint. Returns active partners only. Response includes `onboardingFee` but excludes `commissionType`, `commissionValue`, and `onboardPercentage`. Saves first partner `id` to `{{partnerId}}`."
              }
            },
            {
              "name": "Get partner by ID",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const res = pm.response.json();",
                      "pm.test('Status 200', () => pm.response.to.have.status(200));",
                      "const partner = res.data;",
                      "pm.test('Public shape: includes onboardingFee key', () => {",
                      "  pm.expect(partner).to.have.property('onboardingFee');",
                      "});",
                      "pm.test('Public shape: no commission fields', () => {",
                      "  pm.expect(partner).to.not.have.property('commissionType');",
                      "  pm.expect(partner).to.not.have.property('commissionValue');",
                      "  pm.expect(partner).to.not.have.property('onboardPercentage');",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/partners/{{partnerId}}",
                "description": "Public endpoint. Returns a single **active** partner. Missing, disabled, or unknown IDs return **404**:\n```json\n{ \"status\": false, \"message\": \"Not Found\", \"error\": \"Partner <uuid> not found\" }\n```"
              }
            },
            {
              "name": "Get partner by ID (404 — not found)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 404', () => pm.response.to.have.status(404));",
                      "const res = pm.response.json();",
                      "pm.test('Error envelope', () => {",
                      "  pm.expect(res.status).to.eql(false);",
                      "  pm.expect(res.message).to.eql('Not Found');",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/partners/00000000-0000-0000-0000-000000000000",
                "description": "Example of a valid UUID that does not exist (or partner is inactive)."
              }
            },
            {
              "name": "Get partner by ID (400 — invalid UUID)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 400', () => pm.response.to.have.status(400));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/partners/not-a-valid-uuid",
                "description": "Invalid UUID format returns **400** validation error."
              }
            }
          ]
        },
        {
          "name": "Partner portal",
          "item": [
            {
              "name": "Change password (required on first login)",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currentPassword\": \"TEMP_PASSWORD_FROM_EMAIL\",\n  \"newPassword\": \"NewSecurePass123\"\n}"
                },
                "url": "{{baseUrl}}/partners/profile/me/password",
                "description": "Use the temporary password from the welcome email as `currentPassword`. Clears `mustChangePassword` so other partner routes work."
              }
            },
            {
              "name": "Update own profile",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"description\": \"Updated partner description\"\n}"
                },
                "url": "{{baseUrl}}/partners/profile/me"
